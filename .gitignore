# ============================================================
#  侦探神宫寺三郎 — 白影的少女 · GBA 汉化工程
#  Git 忽略规则
#
#  原则：只提交"人写的东西"（源码 / 译文 / 映射 / 文档 / 校对图），
#        不提交系统垃圾、缓存、构建产物、版权数据。
# ============================================================

# ---------- 操作系统杂项（macOS / Windows / Linux） ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~
*.tmproj
*.bak

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 运行时缓存 / 构建产物 ----------
# work/ 里全是可再生的中间产物（截图、即时存档、RAM dump、批处理导出、
# 字体中间物、编译好的 harness…）。跑 make 会自动重建，整个目录可直接删。
/work/
/build/
/dist/
/out/
*.log

# ---------- 动态回归（tests/dyn/） ----------
# tests/dyn/checks.json 与 tests/dyn/baseline.json 是**要入库**的规格与基线；
# 跑出来的证据（RAM 快照 / 截图 / harness 输出）统一写进 work/dyn/，已被 /work/ 覆盖。
# 这里只兜住「把工作目录指到 tests/dyn 下」的情况，以及下面这个例外目录。
/tests/dyn/out/

# tests/dyn/ss/：手工/脚本存下来的起点即时存档。
# 为什么单独放这儿而不是 work/：即时存档与 ROM 构建版本绑定、不能入库（见 *.ssN 规则），
# 但 tools/crash_bisect.py 复现崩溃时**必须**有一份跨 make clean 活下来的起点存档。
# 所以目录入库（.gitkeep）、内容不入库。
/tests/dyn/ss/*
!/tests/dyn/ss/.gitkeep

# ---------- 无头 harness 的原始截图 ----------
# gbarun_dbg 直接写 .ppm，核对排版时才转成 .png（png 也不提交，见下）
*.ppm
/shot_*.png
/play_*.png
/state_*.png
# 自动游玩选项审核图与索引（也覆盖自定义 --out 目录）
choice-review/

# ---------- 仓库根目录的散落产物 ----------
# 排查时经常顺手把中间结果丢在根目录（RAM dump、拼出来的子 ROM、临时导出）；
# 这些一律不入库。注意只针对根目录，data/ 与 tests/ 下的同名文件不受影响。
/*.ewram
/*.iwram
/*.vram
/*_mem.bin
/*_mem.idx
/*.dump
/*.tmp
/out*.gba
/sub*.gba
/*.pdf

# ---------- iCloud 不同步目录 / 生成物指纹 ----------
# *.nosync 是「让 iCloud 跳过同步」的命名约定（见 docs/字形PNG底稿.md）
*.nosync/
# scene_index.py build 写的主表 sha1，merge_scene_edits.py 用它判断索引是否过期
*.sig

# ---------- 编译产物（C 工具等） ----------
*.o
*.a
*.so
*.dylib
*.dSYM/
/gbarun

# ---------- ROM 与模拟器数据 ----------
# 原版 ROM 是版权输入、汉化 ROM 是构建产物，二者都只留在本地
*.gba
*.gbc
*.gb
*.gba.bak
# 存档 / 即时存档 / 金手指
*.sav
*.ss[0-9]
*.state
*.state[0-9]
*.sgm
*.cht
# GBA BIOS（版权文件，自行准备）
*.bios
*BIOS*.bin

# ---------- 场景索引指纹（scene_index.py build 生成） ----------
# 记录 scene_lines.tsv 是从哪一版 data/translation.tsv 生成的，
# merge_scene_edits.py 用它判断索引是否过期
/data/scene_lines.tsv.sig

# ---------- 工具生成的字形图 ----------
# 注意：data/sheets_jp/*.png 是校对源图，必须保留
/font_sheet*.png
/render_*.png
/out_*.png

# ---------- data/glyph_png：字形 PNG 底稿（本地生成 + 手工改字） ----------
# 3206 张 128×128 PNG + manifest.tsv（约 13 MB），由 tools/export_glyphs.py 生成，
# 不进版本库。真实目录已改名 data/glyph_png.nosync（iCloud 跳过 .nosync 后缀），
# data/glyph_png 保留为指向它的软链接，工具/脚本里的路径不用改。
# 说明文档：docs/字形PNG底稿.md；目录丢了重跑 export_glyphs.py 即可。
/data/glyph_png
/data/glyph_png.nosync/

# ---------- legacy/：模拟器验证链备份 ----------
# GBA BIOS（版权文件）
/legacy/bios/
/legacy/gba_bios.zip
*.pre-insert

.env.vars
